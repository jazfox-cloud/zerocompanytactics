---
import BaseLayout from '../layouts/BaseLayout.astro';
import LastVerified from '../components/evidence/LastVerified.astro';
import SourceList from '../components/evidence/SourceList.astro';
import type { RouteConfig, SourceRecord } from '../config/schema.ts';

interface TimelineItem { state: 'released' | 'announced' | 'unknown'; date: string; title: string; summary: string }
interface Props { route: RouteConfig; heading: string; items: TimelineItem[]; verifiedDate: string; sources: SourceRecord[]; noindex?: boolean }
const { route, heading, items, verifiedDate, sources, noindex = !route.published } = Astro.props;
---

<BaseLayout title={route.title} description={route.description} path={route.path} noindex={noindex}>
  <article class="shell timeline-page">
    <header><p class="eyebrow">Status timeline</p><h1>{heading}</h1><LastVerified date={verifiedDate} /></header>
    <div class="timeline">{items.map((item) => <section data-state={item.state}><span>{item.state}</span><time>{item.date}</time><h2>{item.title}</h2><p>{item.summary}</p></section>)}</div>
    <SourceList sources={sources} />
  </article>
</BaseLayout>
<style>.timeline-page{padding:2rem 0}.timeline-page h1{font-size:clamp(2.3rem,7vw,4.8rem);line-height:1.02}.timeline{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:3rem 0}.timeline section{padding-top:1rem;border-top:2px solid var(--accent)}.timeline span{display:block;color:var(--accent-light);font-size:.72rem;font-weight:800;text-transform:uppercase}.timeline time,.timeline p{color:var(--muted)}@media(max-width:760px){.timeline{grid-template-columns:1fr}}</style>
