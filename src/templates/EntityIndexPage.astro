---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from '../components/evidence/EvidenceBadge.astro';
import LastVerified from '../components/evidence/LastVerified.astro';
import type { EvidenceClass, RouteConfig } from '../config/schema.ts';

interface Entity { id: string; name: string; summary: string; evidenceClass: EvidenceClass; verifiedDate: string }
interface Props { route: RouteConfig; heading: string; coverage: string; entities: Entity[]; noindex?: boolean }
const { route, heading, coverage, entities, noindex = !route.published } = Astro.props;
---

<BaseLayout title={route.title} description={route.description} path={route.path} noindex={noindex}>
  <section class="shell entity-page">
    <header><p class="eyebrow">Verified entity index</p><h1>{heading}</h1><p class="coverage">{coverage}</p></header>
    <div class="entity-grid">{entities.map((entity) => <article id={entity.id}><EvidenceBadge level={entity.evidenceClass} /><h2>{entity.name}</h2><p>{entity.summary}</p><LastVerified date={entity.verifiedDate} /></article>)}</div>
  </section>
</BaseLayout>
<style>.entity-page{padding:2rem 0}.entity-page h1{font-size:clamp(2.3rem,7vw,4.8rem);line-height:1.02}.coverage{max-width:65ch;color:var(--muted-strong)}.entity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:3rem}.entity-grid article{padding:1.2rem;border:1px solid var(--line);border-radius:14px;background:var(--paper)}.entity-grid p{color:var(--muted)}@media(max-width:760px){.entity-grid{grid-template-columns:1fr}}</style>
