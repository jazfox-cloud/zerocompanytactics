---
import BaseLayout from '../layouts/BaseLayout.astro';
import SourceList from '../components/evidence/SourceList.astro';
import ClassDecisionTable from '../components/game/ClassDecisionTable.astro';
import OfficialMedia from '../components/game/OfficialMedia.astro';
import OperatorDossier from '../components/game/OperatorDossier.astro';
import VerificationPanel from '../components/game/VerificationPanel.astro';
import type { FactRecord, MediaRecord, RouteConfig, SourceRecord } from '../config/schema.ts';

interface Props {
  route: RouteConfig;
  eyebrow: string;
  heading: string;
  intro: string;
  coverage: string;
  variant: 'classes' | 'operators';
  entities: FactRecord[];
  media: MediaRecord;
  mediaSource: SourceRecord;
  sources: SourceRecord[];
  verifiedDate: string;
  boundary: string;
}

const { route, eyebrow, heading, intro, coverage, variant, entities, media, mediaSource, sources, verifiedDate, boundary } = Astro.props;
---

<BaseLayout title={route.title} description={route.description} path={route.path} noindex={!route.published}>
  <section class="shell entity-hero">
    <div class="entity-hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lede">{intro}</p>
    </div>
    <OfficialMedia media={media} source={mediaSource} priority={true} />
  </section>

  <section class="shell coverage" aria-labelledby="coverage-heading">
    <div><p class="eyebrow">COVERAGE BOUNDARY</p><h2 id="coverage-heading">What this index covers</h2></div>
    <p>{coverage}</p>
  </section>

  <section class="shell entity-content" aria-label={variant === 'classes' ? 'Verified Specializations' : 'Verified Operators'}>
    {variant === 'classes' ? <ClassDecisionTable facts={entities} /> : <OperatorDossier facts={entities} />}
  </section>

  <section class="shell evidence-section">
    <VerificationPanel date={verifiedDate} evidence="Electronic Arts first-party game and gameplay records" boundary={boundary} />
    <SourceList sources={sources} />
  </section>
</BaseLayout>

<style>
  .entity-hero { display: grid; grid-template-columns: minmax(0, .85fr) minmax(420px, 1.15fr); align-items: center; gap: clamp(2rem, 6vw, 5rem); padding: clamp(3.5rem, 8vw, 7rem) 0 3rem; }
  .entity-hero__copy { position: relative; z-index: 1; }
  h1 { max-width: 11ch; margin: .25rem 0 1rem; font-size: clamp(3rem, 7.5vw, 6.8rem); }
  .lede { max-width: 60ch; color: var(--muted-strong); font-size: 1.08rem; }
  .coverage { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(2rem, 7vw, 6rem); padding: 2.5rem 0; border-block: 1px solid var(--line); }
  .coverage h2 { margin: .2rem 0 0; font-size: clamp(2rem, 5vw, 3.6rem); }
  .coverage > p { margin: 0; color: var(--text-muted); }
  .entity-content, .evidence-section { padding: 2.5rem 0; }
  .evidence-section { display: grid; gap: 1rem; }
  @media (max-width: 900px) { .entity-hero, .coverage { grid-template-columns: 1fr; } .entity-hero { padding-top: 3rem; } }
</style>
