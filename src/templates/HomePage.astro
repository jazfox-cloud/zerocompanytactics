---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfficialMedia from '../components/game/OfficialMedia.astro';
import TacticalTaskBoard from '../components/game/TacticalTaskBoard.astro';
import VerificationPanel from '../components/game/VerificationPanel.astro';
import SourceList from '../components/evidence/SourceList.astro';
import type { MediaRecord, RouteConfig, SourceRecord } from '../config/schema.ts';

interface Props {
  route: RouteConfig;
  eyebrow: string;
  heading: string;
  intro: string;
  media: MediaRecord;
  mediaSource: SourceRecord;
  tasks: { label: string; href: string; description: string; status: 'VERIFIED' | 'BOUNDED' }[];
  facts: { label: string; value: string }[];
  sources: SourceRecord[];
  verifiedDate: string;
  boundary: string;
}

const { route, eyebrow, heading, intro, media, mediaSource, tasks, facts, sources, verifiedDate, boundary } = Astro.props;
---

<BaseLayout title={route.title} description={route.description} path={route.path} noindex={!route.published}>
  <section class="shell hero">
    <div class="hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      <p class="lede">{intro}</p>
      <div class="hero__actions">
        <a class="action action--primary" href="/classes/">Compare verified classes</a>
        <a class="action" href="/operators/">Review verified operators</a>
      </div>
      <a class="official-action" href={mediaSource.url} rel="noreferrer" target="_blank">Open the official game page <span aria-hidden="true">↗</span></a>
    </div>
    <OfficialMedia media={media} source={mediaSource} priority={true} />
  </section>

  <section class="shell task-section" aria-labelledby="task-heading">
    <div class="section-heading"><p class="eyebrow">MISSION SELECT</p><h2 id="task-heading">What do you need to decide?</h2></div>
    <TacticalTaskBoard links={tasks} />
  </section>

  <section class="shell game-overview" aria-labelledby="overview-heading">
    <div><p class="eyebrow">OFFICIAL SCOPE</p><h2 id="overview-heading">The verified field brief</h2><p>These launch-facing facts come from the first-party records listed below. Search demand informed the task order; it did not supply game facts.</p></div>
    <dl>{facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}</dl>
  </section>

  <section class="shell evidence-section">
    <VerificationPanel date={verifiedDate} evidence="Electronic Arts product, Q&A, launch, and gameplay records" boundary={boundary} />
    <SourceList sources={sources} />
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); align-items: center; gap: clamp(2rem, 6vw, 5rem); padding: clamp(3.5rem, 8vw, 7rem) 0 4rem; }
  .hero__copy { position: relative; z-index: 1; }
  h1 { max-width: 10ch; margin: .25rem 0 1rem; font-size: clamp(3rem, 7.5vw, 6.8rem); }
  .lede { max-width: 58ch; color: var(--muted-strong); font-size: 1.08rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.6rem; }
  .action { min-height: 46px; display: inline-flex; align-items: center; padding: .7rem 1rem; border: 1px solid var(--line-strong); color: var(--text-main); font-weight: 850; text-decoration: none; text-transform: uppercase; }
  .action--primary { color: var(--surface-deep); border-color: var(--accent-orange); background: var(--accent-orange); }
  .official-action { min-height: 44px; display: inline-flex; align-items: center; margin-top: .7rem; font-size: .82rem; font-weight: 800; }
  .task-section, .game-overview, .evidence-section { padding: 2.5rem 0; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .section-heading h2, .game-overview h2 { margin: .2rem 0 1rem; font-size: clamp(2rem, 5vw, 3.6rem); }
  .game-overview { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 7vw, 6rem); }
  .game-overview p { color: var(--text-muted); }
  dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0; background: var(--line); }
  dl div { min-height: 120px; padding: 1rem; background: var(--surface-sand); }
  dt { color: hsl(201 18% 38%); font-family: var(--font-mono); font-size: .68rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  dd { margin: .65rem 0 0; color: var(--text-dark); font-size: 1.05rem; font-weight: 800; }
  .evidence-section { display: grid; gap: 1rem; }
  @media (max-width: 900px) { .hero, .game-overview { grid-template-columns: 1fr; } .hero { padding-top: 3rem; } }
  @media (max-width: 560px) { dl { grid-template-columns: 1fr; } }
</style>
