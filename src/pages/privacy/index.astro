---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Privacy — Zero Company Field Guide" description="Privacy information for Zero Company Field Guide." path="/privacy/" noindex={true}>
  <article class="shell legal">
    <p class="eyebrow">PRIVACY NOTICE</p>
    <h1>Privacy</h1>
    <p>This website does not enable analytics or advertising. It does not intentionally set measurement or advertising cookies.</p>
    <h2>External links</h2>
    <p>Links to Electronic Arts and YouTube leave this local guide. The embedded official trailer uses YouTube's privacy-enhanced domain, but loading or playing it may still connect your browser to YouTube. Those services apply their own privacy practices.</p>
    <h2>Hosting</h2>
    <p>The site is delivered through Cloudflare Pages. Cloudflare may process technical request data required to serve and protect the website under its own privacy terms.</p>
  </article>
</BaseLayout>
<style>.legal{max-width:780px;padding:4rem 0}.legal h1{font-size:clamp(2.7rem,7vw,5rem)}.legal h2{margin-top:2.2rem}.legal p{color:var(--muted-strong)}</style>
