---
import { navigation, routes, siteConfig } from '../../config/index.ts';

const visiblePaths = new Set(routes.filter((route) => route.published || route.releaseState === 'LOCAL_ONLY').map((route) => route.path));
const visibleNavigation = navigation.filter((item) => visiblePaths.has(item.href));
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label={`${siteConfig.name} home`}>
      <img src={siteConfig.brand.logoPath} alt="" width="36" height="36" />
      <span>{siteConfig.shortName}</span>
    </a>
    <nav class="desktop-navigation" aria-label="Primary navigation">
      {visibleNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <details class="mobile-navigation">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">{visibleNavigation.map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    </details>
  </div>
</header>
