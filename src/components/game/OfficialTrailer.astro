---
import type { SourceRecord } from '../../config/schema.ts';

interface Props {
  source: SourceRecord;
  title: string;
  videoId: string;
}

const { source, title, videoId } = Astro.props;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
---

<figure class="trailer">
  <div class="trailer__frame">
    <iframe
      src={embedUrl}
      title={title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption>
    <span>{title} — official Electronic Arts video.</span>
    <a href={source.url} rel="noreferrer" target="_blank">Watch on YouTube <span aria-hidden="true">↗</span></a>
  </figcaption>
</figure>

<style>
  .trailer { margin: 0; border: 1px solid var(--line-strong); background: var(--surface-deep); box-shadow: 10px 10px 0 color-mix(in srgb, var(--accent-orange) 25%, transparent); }
  .trailer__frame { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #05080a; }
  iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 1rem; color: var(--muted-strong); font-size: .8rem; }
  a { flex: none; font-weight: 850; }
  @media (max-width: 560px) { figcaption { align-items: flex-start; flex-direction: column; } }
</style>
