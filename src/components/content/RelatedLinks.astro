---
interface Link { label: string; href: string }
interface Props { links: Link[] }
const { links } = Astro.props;
---

{links.length > 0 && <nav class="related-links" aria-label="Related pages">
  <h2>Related pages</h2>
  <ul>{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
</nav>}
